# OSBB Platform environment contract
#
# Never commit real environment values, credentials, tokens, passwords,
# project references, or production configuration.
#
# IMPORTANT:
# Every variable prefixed with NEXT_PUBLIC_ is exposed to the browser bundle.
# Never place secrets in a NEXT_PUBLIC_ variable.

# ----------------------------------------------------------------------
# Required public Supabase configuration
# ----------------------------------------------------------------------

# Public Supabase project URL. Exposed to the browser bundle.
NEXT_PUBLIC_SUPABASE_URL=

# Public Supabase publishable key. Exposed to the browser bundle.
# Access must remain protected by Supabase RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ----------------------------------------------------------------------
# Public application domains
# ----------------------------------------------------------------------

# Public admin hostname used to build employee invitation links.
# Exposed to the browser bundle.
NEXT_PUBLIC_ADMIN_DOMAIN=

# Optional public root domain override.
# Exposed to the browser bundle.
# Current code has an application fallback when this variable is omitted.
NEXT_PUBLIC_ROOT_DOMAIN=

# ----------------------------------------------------------------------
# Required server-only secrets
# ----------------------------------------------------------------------

# SERVER-ONLY SECRET.
# This key bypasses Supabase RLS and must never be exposed through NEXT_PUBLIC_*,
# client components, browser bundles, logs, or committed files.
SUPABASE_SERVICE_ROLE_KEY=

# ----------------------------------------------------------------------
# Optional server-only feature flags
# ----------------------------------------------------------------------

# Optional server-side PDF generation override.
# Current code treats any non-empty value as enabled.
ALLOW_LOCAL_PDF_GENERATION=

# ----------------------------------------------------------------------
# Platform-managed build/runtime variables
# ----------------------------------------------------------------------
#
# These variables are read by current code but are normally supplied by
# Node.js, Next.js, or Vercel rather than configured manually.
#
# NODE_ENV=
# VERCEL=

# ----------------------------------------------------------------------
# Legacy compatibility aliases
# ----------------------------------------------------------------------
#
# Current tracked code still recognizes these aliases in limited legacy
# readers or maintenance scripts. Do not configure them for new environments.
# Prefer the canonical variables declared above.
#
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_ANON_KEY=
# SUPABASE_PROJECT_URL=
#
# SERVER-ONLY LEGACY SECRET alias for SUPABASE_SERVICE_ROLE_KEY:
# SUPABASE_SERVICE_KEY=
#
# SUPABASE_URL=
